{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-compass.local/schemas/research-agent-record.schema.json",
  "title": "Career Compass Research Agent Record",
  "description": "Evidence-backed Zambia-first records for employers, opportunities, professions, training, and source references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "canonical_name",
    "sources",
    "verification_status",
    "confidence",
    "needs_review"
  ],
  "properties": {
    "record_type": {
      "type": "string",
      "enum": [
        "organization",
        "opportunity",
        "profession",
        "training",
        "source"
      ]
    },
    "canonical_name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "country": {
      "type": "string",
      "default": "Zambia"
    },
    "province": {
      "type": [
        "string",
        "null"
      ]
    },
    "city": {
      "type": [
        "string",
        "null"
      ]
    },
    "sector": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "website_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "careers_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "application_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public_phone": {
          "type": [
            "string",
            "null"
          ]
        },
        "public_email": {
          "type": [
            "string",
            "null"
          ],
          "format": "email"
        },
        "contact_page": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "precision": {
          "type": "string",
          "enum": [
            "exact",
            "street",
            "neighborhood",
            "city",
            "approximate",
            "unknown"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "opportunity_details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "job",
            "internship",
            "wil",
            "graduate_programme",
            "apprenticeship",
            "bursary",
            "volunteering",
            "training",
            "other",
            null
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "active",
            "closing_soon",
            "expired",
            "unclear",
            "unverified",
            null
          ]
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "application_method": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "profession_details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonical_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "alternative_titles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "qualifications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pathway": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "title",
          "source_type",
          "evidence_quote",
          "checked_at",
          "access_status"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "enum": [
              "official",
              "government",
              "university",
              "professional_body",
              "job_board",
              "news",
              "directory",
              "social",
              "api",
              "other"
            ]
          },
          "evidence_quote": {
            "type": "string",
            "minLength": 1
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "access_status": {
            "type": "string",
            "enum": [
              "verified",
              "redirected",
              "inaccessible",
              "dead",
              "suspicious"
            ]
          }
        }
      }
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified",
        "partially_verified",
        "unverified",
        "needs_review"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "needs_review": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
